# Modèle du fichier .env (à copier en .env, qui n'est jamais versionné).
# Format : CLE=valeur, sans guillemets ni espaces autour du « = ».

# Profil Spring : dev (avec données de démonstration) ou prod
spring.profiles.active=dev

# Base PostgreSQL
NGOMA_DB_URL=jdbc:postgresql://localhost:5432/ngoma
NGOMA_DB_USER=ngoma
NGOMA_DB_PASSWORD=a-remplacer

# Clé de signature des jetons JWT, en Base64, 256 bits minimum.
# Générer une clé : openssl rand -base64 48
NGOMA_JWT_SECRET=a-remplacer

# Paiement : en profil dev, l'opérateur simulé est utilisé (aucun compte marchand requis).
# NGOMA_PAIEMENT_FOURNISSEUR=simulation
# NGOMA_PAIEMENT_CLE=
# NGOMA_PAIEMENT_SECRET=

# Stockage des images (facultatif ; par défaut dossier uploads/ servi sur http://localhost:8090/medias)
# NGOMA_STOCKAGE_DOSSIER=uploads
# NGOMA_STOCKAGE_URL=http://localhost:8090/medias

# Tests sur base de données (facultatif) : base dédiée, chaque test est annulé en fin d'exécution
# NGOMA_TEST_DB_URL=jdbc:postgresql://localhost:5432/ngoma_test
